# QuizForge 環境變數範本。複製為 `.env` 並填入實際值；`.env` 不進 Git。
# 完整說明見 docs/architecture.md。

# ---- LLM（OpenAI-compatible 介面，預設供應商 OpenRouter）----
# OpenRouter chat 與 embeddings 共用同一把 key、同一個 base_url。
LLM_BASE_URL=https://openrouter.ai/api/v1
# 換成你自己的 key；絕對不要把真實 key 寫進任何會進 Git 的檔案。
LLM_API_KEY=sk-or-REPLACE_WITH_YOUR_KEY
# 掃描件 / PDF / 圖片解析用的 vision model。
VISION_MODEL=google/gemini-3.6-flash
# 摘要／分類／出題共用的文字 model。
TEXT_MODEL=openai/gpt-5.6-luna
# chunk 向量化用的 embedding model。
EMBEDDING_MODEL=openai/text-embedding-3-small
# 對應 embedding model 輸出維度；pgvector 建表用。更換 embedding model
# 需要 re-embed 全部 chunk 並跑 migration，屬於重大變更。
EMBEDDING_DIM=1536
# LLM 呼叫併發數上限（asyncio.Semaphore）。
LLM_CONCURRENCY=4
# PDF 轉頁面圖片的 DPI，數字愈高圖愈清楚但檔案愈大、token 花費愈多。
OCR_DPI=200
# chunk 依標題結構切分後，單一 chunk 內容長度上限（字元數）；超過會再依段落續切。
CHUNK_MAX_CHARS=4000

# ---- 出題（docs/question-bank.md）----
# 比較題配對用的 cosine 相似度中間帶：兩個 chunk 的相似度需落在 [MIN, MAX]
# 之間才會被配成一組比較題（低於 MIN 視為不相關，高於 MAX 視為幾乎重複）。
COMPARISON_SIMILARITY_MIN=0.35
COMPARISON_SIMILARITY_MAX=0.75

# ---- 背景任務（pg-as-queue，見 docs/architecture.md）----
# FastAPI lifespan 啟動的 asyncio worker 數量。
JOB_WORKER_COUNT=2
# worker 沒領到任務時的輪詢間隔（秒）。
JOB_POLL_INTERVAL_SECONDS=1.0

# ---- 基礎設施 ----
# asyncpg 連線字串，host 對應下面 db 服務的名稱（compose 內部網路）。
DATABASE_URL=postgresql+asyncpg://quizforge:change-me@db:5432/quizforge
# container 內部的資料根目錄，實際內容經由 docker-compose bind mount 對應到
# data/container-mounts/{uploads,assets,exports}。
DATA_DIR=/data

# ---- PostgreSQL（db 服務，pgvector/pgvector image）----
POSTGRES_USER=quizforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quizforge

# ---- nginx（唯一對外服務）----
# 對外（host 端）監聽的 port，避免跟本機其他服務衝突時可自行調整。
NGINX_HTTP_PORT=8080
